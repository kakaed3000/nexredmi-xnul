 static void
+angelica_reg_write(uint32_t pa, uint32_t value)
+{
+	for (unsigned int i = 0; i < sizeof(angelica_reg_pages) / sizeof(angelica_reg_pages[0]); i++) {
+		if ((pa & ~0xfffU) == angelica_reg_pages[i].pa && angelica_reg_pages[i].va != 0) {
+			*(volatile uint32_t *)(angelica_reg_pages[i].va + (pa & 0xfffU)) = value;
+			return;
+		}
+	}
+}
+
+/*
+ * Stock ATF's cluster power-on path releases MP1 bus protection through
+ * INFRA_TOPAXI_PROTECTEN_1_CLR. CPU4 can be powered and have a valid boot
+ * address while still stalling on instruction fetch behind that protection.
+ * Replay the MP1 part before asking PSCI to start CPU4.
+ */
+static void
+angelica_cluster1_bus_release(void)
+{
+	angelica_prot_before = angelica_reg_read(0x10001258);
+	angelica_top_before = angelica_reg_read(0x10006218);
+	uint32_t top = angelica_top_before;
+	top &= ~0x8U;   /* PWR_ON_2ND */
+	top |= 0x1U;    /* PWR_RST_B */
+	top &= ~0x10U;  /* PWR_CLK_DIS */
+	top |= 0x4U;    /* PWR_ON */
+	angelica_reg_write(0x10006218, top);
+	__builtin_arm_dsb(DSB_SY);
+	angelica_reg_write(0x100012ac, 0x0800c800U);
+	__builtin_arm_dsb(DSB_SY);
+	angelica_prot_after = angelica_reg_read(0x10001258);
+	angelica_top_after = angelica_reg_read(0x10006218);
+}
