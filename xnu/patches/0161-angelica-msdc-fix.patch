+/*
+ * One-sided sampling edge control, modelled on
+ * drivers/mmc/host/mediatek/ComboA/sd.c msdc_set_smpl(): clock_mode 0 only.
+ * edges are 0 (rising) or 1 (falling).
+ */
+static void
+msdc_set_smpl(uint32_t clock_mode, uint8_t cmd_edge, uint8_t rdata_edge,
+    uint8_t wdata_edge)
+{
+	uint32_t iocon = msdc_rd(MSDC_IOCON);
+	uint32_t pb0, pb2;
+
+	if (clock_mode != 0) {
+		return;
+	}
+	if (cmd_edge <= 1) {
+		iocon &= ~MSDC_IOCON_RSPL;
+		iocon |= (uint32_t)cmd_edge << 1;
+	}
+	iocon &= ~MSDC_IOCON_R_D_SMPL_SEL;
+	msdc_wr(MSDC_IOCON, iocon);
+	if (rdata_edge <= 1) {
+		pb0 = msdc_rd(MSDC_PATCH_BIT0);
+		pb0 &= ~MSDC_PB0_RD_DAT_SEL;
+		pb0 |= (uint32_t)rdata_edge << 3;
+		msdc_wr(MSDC_PATCH_BIT0, pb0);
+	}
+	if (wdata_edge <= 1) {
+		pb2 = msdc_rd(MSDC_PATCH_BIT2);
+		pb2 &= ~MSDC_PB2_CFGCRCSTSEDGE;
+		pb2 |= (uint32_t)wdata_edge << 25;
+		msdc_wr(MSDC_PATCH_BIT2, pb2);
+	}
+}
