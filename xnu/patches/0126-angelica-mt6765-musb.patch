+void
+angelica_usb_probe(void)
+{
+	int enabled = 1;
+	vm_offset_t musb;
+	vm_offset_t phy;
+	vm_offset_t topckgen;
+	vm_offset_t infracfg;
+	vm_offset_t pericfg;
+
+	printf("ANGELICA USB: probe enter\n");
+	PE_parse_boot_argn("angelicausb", &enabled, sizeof(enabled));
+	printf("ANGELICA USB: probe mode %d\n", enabled);
+	if (!enabled) {
+		printf("ANGELICA USB: disabled by boot-arg\n");
+		return;
+	}
+	musb = ml_io_map(MUSB_PA, MUSB_SIZE);
+	phy = ml_io_map(PHY_PA, PHY_SIZE);
+	topckgen = ml_io_map(TOPCKGEN_PA, TOPCKGEN_SIZE);
+	infracfg = ml_io_map(INFRACFG_AO_PA, INFRACFG_AO_SIZE);
+	pericfg = ml_io_map(PERICFG_PA, PERICFG_SIZE);
+	if (musb == 0 || phy == 0 || topckgen == 0 || infracfg == 0 ||
+	    pericfg == 0) {
+		printf("ANGELICA USB: map failed\n");
+		return;
+	}
+	ud.musb = musb;
+	ud.phy = phy;
+	ud.topckgen = topckgen;
+	ud.infracfg = infracfg;
+	ud.pericfg = pericfg;
+	printf("ANGELICA USB: musb 0x%lx phy 0x%lx pericfg 0x%08x\n",
+	    (unsigned long)musb, (unsigned long)phy, usb_rd(pericfg, 0));
+	if (enabled >= 2) {
+		angelica_usb_gadget_start(musb);
+		return;
+	}
+	ud_clocks_on();
+	ud_ep_select(0);
+	printf("ANGELICA USB: power 0x%02x devctl 0x%02x cfg 0x%02x hw 0x%02x ep 0x%02x ram 0x%02x\n",
+	    ud_rd8(MUSB_POWER), ud_rd8(MUSB_DEVCTL), ud_rd8(MUSB_CONFIGDATA),
+	    ud_rd8(MUSB_HWVERS), ud_rd8(MUSB_EPINFO), ud_rd8(MUSB_RAMINFO));
+	ud_phy_poweron();
+	printf("ANGELICA USB: phy 68 0x%08x 6c 0x%08x 18 0x%08x 14 0x%08x\n",
+	    ud_phy_rd(0x68), ud_phy_rd(0x6c), ud_phy_rd(0x18), ud_phy_rd(0x14));
+}
