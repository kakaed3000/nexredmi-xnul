+static bool
+ud_configure(void)
+{
+	if (ud.configured) {
+		return true;
+	}
+	ud_ep_select(0);
+	if (!(ud_rd8(MUSB_CONFIGDATA) & 0x04)) {
+		printf("ANGELICA USB: dynamic FIFO not reported\n");
+	}
+	ud_ep_select(1);
+	ud_wr16(ud_epio(MUSB_TXMAXP), 512);
+	ud_wr8(MUSB_TXFIFOSZ, MUSB_FIFOSZ_DPB | 0x06);
+	ud_wr16(MUSB_TXFIFOADD, 512 >> 3);
+	ud_wr16(ud_epio(MUSB_TXCSR), MUSB_TXCSR_MODE | MUSB_TXCSR_CLRDATATOG);
+	ud_wr16(ud_epio(MUSB_TXCSR), MUSB_TXCSR_MODE | MUSB_TXCSR_CLRDATATOG);
+	ud_wr16(ud_epio(MUSB_RXMAXP), 512);
+	ud_wr8(MUSB_RXFIFOSZ, MUSB_FIFOSZ_DPB | 0x06);
+	ud_wr16(MUSB_RXFIFOADD, 1536 >> 3);
+	ud_wr16(ud_epio(MUSB_RXCSR), MUSB_RXCSR_CLRDATATOG);
+	ud_wr16(ud_epio(MUSB_RXCSR), MUSB_RXCSR_CLRDATATOG);
+
+	ud_ep_select(2);
+	ud_wr16(ud_epio(MUSB_TXMAXP), 16);
+	ud_wr8(MUSB_TXFIFOSZ, 0x03);
+	ud_wr16(MUSB_TXFIFOADD, 2560 >> 3);
+	ud_wr16(ud_epio(MUSB_TXCSR), MUSB_TXCSR_MODE | MUSB_TXCSR_CLRDATATOG);
+	ud_wr16(ud_epio(MUSB_TXCSR), MUSB_TXCSR_MODE | MUSB_TXCSR_CLRDATATOG);
+
+	ud_ep_select(0);
+	ud_wr16(MUSB_INTRTXE, (1u << 0) | (1u << 1) | (1u << 2));
+	ud_wr16(MUSB_INTRRXE, 1u << 1);
+	ud.tx_busy = false;
+	ud.tx_need_zlp = false;
+	ud.tx_zlp_sent = false;
+	ud.ep2_busy = false;
+	ud.rx_len = 0;
+	ud.configured = true;
+	printf("ANGELICA USB: ECM endpoints configured\n");
+	return true;
+}
+
+static void
+ud_unconfigure(void)
+{
+	lck_mtx_lock(ud.lock);
+	ud_txq_flush_locked();
+	ud.tx_busy = false;
+	ud.tx_need_zlp = false;
+	ud.tx_zlp_sent = false;
+	ud.ep2_busy = false;
+	ud.pending_notify = false;
+	ud.rx_len = 0;
+	ud.configured = false;
+	ud.data_alt = 0;
+	lck_mtx_unlock(ud.lock);
+	ud_ep_select(1);
+	ud_wr16(ud_epio(MUSB_TXMAXP), 0);
+	ud_wr16(ud_epio(MUSB_RXMAXP), 0);
+	uint16_t txcsr = ud_rd16(ud_epio(MUSB_TXCSR));
+	txcsr |= MUSB_TXCSR_FLUSHFIFO | MUSB_TXCSR_P_WZC_BITS;
+	txcsr &= ~MUSB_TXCSR_TXPKTRDY;
+	ud_wr16(ud_epio(MUSB_TXCSR), txcsr);
+	uint16_t rxcsr = ud_rd16(ud_epio(MUSB_RXCSR));
+	rxcsr |= MUSB_RXCSR_FLUSHFIFO | MUSB_RXCSR_P_WZC_BITS;
+	rxcsr &= ~MUSB_RXCSR_RXPKTRDY;
+	ud_wr16(ud_epio(MUSB_RXCSR), rxcsr);
+	ud_ep_select(2);
+	ud_wr16(ud_epio(MUSB_TXMAXP), 0);
+	txcsr = ud_rd16(ud_epio(MUSB_TXCSR));
+	txcsr |= MUSB_TXCSR_FLUSHFIFO | MUSB_TXCSR_P_WZC_BITS;
+	txcsr &= ~MUSB_TXCSR_TXPKTRDY;
+	ud_wr16(ud_epio(MUSB_TXCSR), txcsr);
+	ud_ep_select(0);
+	ud_wr16(MUSB_INTRTXE, 1);
+	ud_wr16(MUSB_INTRRXE, 0);
+	ud_link_event(false);
+}
