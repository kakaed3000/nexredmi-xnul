+static uint32_t
+ud_string(unsigned idx, uint8_t *out)
+{
+	if (idx == 0) {
+		out[0] = 4;
+		out[1] = 3;
+		out[2] = 0x09;
+		out[3] = 0x04;
+		return 4;
+	}
+	if (idx >= sizeof(ud_strings) / sizeof(ud_strings[0])) {
+		return 0;
+	}
+	const char *str = ud_strings[idx];
+	uint32_t n = 2;
+	for (; *str && n < 126; str++) {
+		out[n++] = (uint8_t)*str;
+		out[n++] = 0;
+	}
+	out[0] = (uint8_t)n;
+	out[1] = 3;
+	return n;
+}
