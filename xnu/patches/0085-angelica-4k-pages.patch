diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 87914ea..a49a66c 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1828,32 +1828,47 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
 #if defined(ANGELICA)
 /*
  * The reserved low-globals/kernel region is excluded from VM allocation.
- * Use the otherwise empty 32MB block above low globals and below gVirtBase
- * for a Normal-NC framebuffer alias that survives bootstrap TTBR0 teardown.
+ * Use the otherwise empty space above the 32MB low-globals block and below
+ * gVirtBase for a Normal-NC framebuffer alias that survives bootstrap TTBR0
+ * teardown.  This is independent of the hardware granule: 4K maps three
+ * 2MB blocks where 16K maps one 32MB block.
  */
-#define ANGELICA_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
+#define ANGELICA_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + (32ULL << 20))
 #ifdef ARM64_BOARD_CONFIG_ANGELICA
+#if defined(__ARM_16K_PG__)
 #define ANGELICA_EARLY_FB_BLOCK_PHYS 0x5e000000ULL
 #define ANGELICA_EARLY_FB_BLOCK_OFFSET 0x605000ULL
+#define ANGELICA_EARLY_FB_BLOCKS 1
+#else
+/* 4K granule: 0x5e605000..0x5ea6a000 spans three 2MB L2 blocks. */
+#define ANGELICA_EARLY_FB_BLOCK_PHYS 0x5e600000ULL
+#define ANGELICA_EARLY_FB_BLOCK_OFFSET 0x5000ULL
+#define ANGELICA_EARLY_FB_BLOCKS 3
+#endif
 #else
 #define ANGELICA_EARLY_FB_BLOCK_PHYS 0x9c000000ULL
 #define ANGELICA_EARLY_FB_BLOCK_OFFSET 0ULL
+#define ANGELICA_EARLY_FB_BLOCKS 1
 #endif
 
 static void
 angelica_early_map_final(void)
 {
 	const vm_map_address_t va = ANGELICA_EARLY_FB_VA;
-	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
+	assert(va + ANGELICA_EARLY_FB_BLOCKS * ARM_TT_L2_SIZE <= gVirtBase);
 	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
 	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
-	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
-	assert(*slot == ARM_TTE_EMPTY);
-	*slot = ANGELICA_EARLY_FB_BLOCK_PHYS | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
-	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
-	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
-	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	for (unsigned int i = 0; i < ANGELICA_EARLY_FB_BLOCKS; i++) {
+		const vm_map_address_t bva = va + i * ARM_TT_L2_SIZE;
+		tt_entry_t *slot = &l2[(bva & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
+		assert(*slot == ARM_TTE_EMPTY);
+		*slot = (ANGELICA_EARLY_FB_BLOCK_PHYS + i * ARM_TT_L2_SIZE) |
+		    ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	}
 	__asm__ volatile("dsb ishst" ::: "memory");
 }
 #endif
diff --git a/osfmk/arm64/proc_reg.h b/osfmk/arm64/proc_reg.h
index e01c124..0fe21e4 100644
--- a/osfmk/arm64/proc_reg.h
+++ b/osfmk/arm64/proc_reg.h
@@ -968,7 +968,10 @@
 #define T1SZ_BOOT 17ULL
 #endif /* !__ARM64_PMAP_SUBPAGE_L1__ */
 #else /* __ARM_16K_PG__ */
-#if __ARM64_PMAP_SUBPAGE_L1__
+#if defined(ARM_LARGE_MEMORY) && !__ARM64_PMAP_SUBPAGE_L1__
+/* Large-memory kernels link at -2TB; T1SZ=23 covers exactly that range. */
+#define T1SZ_BOOT 23ULL
+#elif __ARM64_PMAP_SUBPAGE_L1__
 #define T1SZ_BOOT 26ULL
 #else /* __ARM64_PMAP_SUBPAGE_L1__ */
 #define T1SZ_BOOT 25ULL
@@ -998,7 +1001,12 @@
 
 #if __ARM_KERNEL_PROTECT__
 #define TCR_EL1_BOOT (TCR_EL1_BASE | (T1SZ_BOOT << TCR_T1SZ_SHIFT) | (TCR_TG0_GRANULE_SIZE))
+#if defined(ARM_LARGE_MEMORY) && !defined(__ARM_16K_PG__)
+/* T1SZ_BOOT+1 would cut TTBR1 below the -2TB kernel text at this granule. */
+#define T1SZ_USER T1SZ_BOOT
+#else
 #define T1SZ_USER (T1SZ_BOOT + 1)
+#endif
 #define TCR_EL1_USER (TCR_EL1_BASE | (T1SZ_USER << TCR_T1SZ_SHIFT) | (TCR_TG0_GRANULE_SIZE))
 #else
 #define TCR_EL1_BOOT (TCR_EL1_BASE | (T1SZ_BOOT << TCR_T1SZ_SHIFT) | (TCR_TG0_GRANULE_SIZE))
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 45a7572..53474f3 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -695,16 +695,38 @@ Lkernelcache_base_found:
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
 #ifdef ARM64_BOARD_CONFIG_ANGELICA
+#if defined(__ARM_16K_PG__)
 	MOV64	x10, 0x5e000000
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+	add		x13, x25, #(2 * PGBYTES)
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
 #else
-	MOV64	x10, 0x9c000000
+	/* 4K granule: the 720x1600 fb spans three 2MB L2 blocks at 0x5e600000. */
+	MOV64	x10, 0x5e600000
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	add		x13, x25, #(2 * PGBYTES)
+	mov		x14, #3
+Langelica_nc_4k:
+	orr		x15, x11, x10
+	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+	str		x15, [x13, x12, lsl #TTE_SHIFT]
+	add		x10, x10, #(ARM_TT_L2_SIZE)
+	subs	x14, x14, #1
+	b.ne	Langelica_nc_4k
 #endif
+#else
+	MOV64	x10, 0x9c000000
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+#endif
 #endif
 
 	/* Ensure TTEs are visible */
diff --git a/pexpert/pexpert/arm64/ANGELICA.h b/pexpert/pexpert/arm64/ANGELICA.h
index 341f6f8..93ae560 100644
--- a/pexpert/pexpert/arm64/ANGELICA.h
+++ b/pexpert/pexpert/arm64/ANGELICA.h
@@ -1,6 +1,6 @@
 /*
  * Board config for the Redmi 9C ("angelica", MediaTek MT6765 / Helio G35):
- * 8x Cortex-A53 (ARMv8.0: no PAN, no LSE), 16K pages, GICv3, no PAC.
+ * 8x Cortex-A53 (ARMv8.0: no PAN, no LSE), 4K hardware pages, GICv3, no PAC.
  *
  * The ANGELICA machine config passes BOTH -DARM64_BOARD_CONFIG_ANGELICA and
  * -DARM64_BOARD_CONFIG_ANGELICA, and this header defines ANGELICA as well, so the
@@ -34,8 +34,16 @@
 #define __ARM_ENABLE_SWAP__       1
 #define __ARM_V8_CRYPTO_EXTENSIONS__ 1
 /* Cortex-A53 is ARMv8.0: no FEAT_PAN, leave __ARM_PAN_AVAILABLE__ undefined
- * (same as the upstream BCM2837 board config, also Cortex-A53). */
-#define __ARM_16K_PG__            1
+ * (same as the upstream BCM2837 board config, also Cortex-A53).
+ *
+ * ID_AA64MMFR0_EL1.TGran16 is 1 on this core: only 4K and 64K granules
+ * exist.  Build the page tables for 4K hardware.  Since memSize > 1GB,
+ * arm_init still sets PAGE_SHIFT_CONST to PAGE_MAX_SHIFT (16K), keeping
+ * the 16K software page size and the iOS userland ABI.
+ *
+ * Do not define __ARM64_PMAP_SUBPAGE_L1__: it caps TTBR1 at 512GB and this
+ * kernel is linked with ARM_LARGE_MEMORY at -2TB.
+ */
 
 #define HAS_GIC_V3                1
 
