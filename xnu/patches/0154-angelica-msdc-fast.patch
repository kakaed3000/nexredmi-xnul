 static int
+msdc_read_blocks(uint64_t lba, uint32_t blocks)
+{
+	addr64_t sector_pa;
+	uint32_t max_blocks = sm.bounce_size / MSDC_BLOCK;
+	int error = 0;
+
+	if (blocks == 0 || blocks > max_blocks) {
+		return EINVAL;
+	}
+	sector_pa = kvtophys((vm_offset_t)sm.sector);
+
+	if (blocks == 1) {
+		error = msdc_xfer(lba, 1, sm.sector, sector_pa);
+	} else if (sm.multi) {
+		error = msdc_xfer(lba, blocks, sm.bounce, sm.dma_pa);
+		if (error != 0) {
+			kprintf("ANGELICA MSDC: multi read %u blocks at 0x%llx failed, "
+			    "falling back to single blocks\n", blocks,
+			    (unsigned long long)lba);
+			sm.multi = false;
+		}
+	}
+	if (blocks > 1 && !sm.multi) {
+		for (uint32_t i = 0; i < blocks; i++) {
+			error = msdc_xfer(lba + i, 1, sm.sector, sector_pa);
+			if (error != 0) {
+				break;
+			}
+			memcpy(sm.bounce + (uint64_t)i * MSDC_BLOCK,
+			    sm.sector, MSDC_BLOCK);
+		}
+	}
+	msdc_stat_add(blocks);
+	return error;
+}
+
+/* CMD17 of one 512-byte block into sm.sector; the caller holds the lock. */
+static int
+msdc_read_sector(uint64_t lba)
+{
+	return msdc_read_blocks(lba, 1);
+}
