+static void
+msdc_host_width(uint32_t width)
+{
+	uint32_t cfg = msdc_rd(SDC_CFG);
+	uint32_t value = width == 8 ? 2u : (width == 4 ? 1u : 0u);
+
+	cfg = (cfg & ~SDC_CFG_BUSWIDTH) | (value << 16);
+	msdc_wr(SDC_CFG, cfg);
+	sm.width = width;
+}
+
+static int
+msdc_set_clock(uint32_t div)
+{
+	uint32_t cfg = msdc_rd(MSDC_CFG);
+
+	cfg &= ~(MSDC_CFG_CKMOD | MSDC_CFG_CKMOD_HS400 | MSDC_CFG_SCLK_STOP_DDR);
+	cfg = (cfg & ~MSDC_CFG_CKDIV) | ((div & 0xfffu) << 8);
+	msdc_wr(MSDC_CFG, cfg);
+	for (uint32_t i = 0; !(msdc_rd(MSDC_CFG) & MSDC_CFG_CKSTB) && i < 1000; i++) {
+		delay(1);
+	}
+	if (!(msdc_rd(MSDC_CFG) & MSDC_CFG_CKSTB)) {
+		return ETIMEDOUT;
+	}
+	sm.clock_div = div;
+	return 0;
+}
+
+static int
+msdc_set_bus_width(uint32_t width)
+{
+	uint32_t value = width == 8 ? 2u : 1u;
+	uint32_t arg = (MSDC_SWITCH_WRITE << 24) |
+	    (EXT_CSD_BUS_WIDTH << 16) | (value << 8);
+	uint32_t resp = 0;
+	int error;
+
+	error = msdc_cmd(6, arg, R1B_RSPTYP, 0, &resp);
+	if (error != 0) {
+		return error;
+	}
+	if (resp & (R1_OUT_OF_RANGE | R1_ERROR)) {
+		kprintf("ANGELICA MSDC: CMD6 bus width status 0x%x\n", resp);
+		return EIO;
+	}
+	error = msdc_wait_ready();
+	if (error != 0) {
+		return error;
+	}
+	msdc_host_width(width);
+	return 0;
+}
