+/*
+ * Stock ATF's SPMC tables describe MP0/MP1 boot addresses at 0x10200038 and
+ * 0x10200238 with an 8-byte per-CPU stride. Read both clusters' power state
+ * and boot address around CPU_ON to see where cluster1 bring-up stops.
+ */
+struct angelica_reg_page {
+	vm_offset_t pa;
+	vm_offset_t va;
+};
+
+static struct angelica_reg_page angelica_reg_pages[] = {
+	{ 0x10006000, 0 },
+	{ 0x10200000, 0 },
+	{ 0x10201000, 0 },
+	{ 0x10203000, 0 },
+	{ 0x10226000, 0 },
+};
+
+static void
+angelica_map_smp_regs(void)
+{
+	for (unsigned int i = 0; i < sizeof(angelica_reg_pages) / sizeof(angelica_reg_pages[0]); i++) {
+		if (angelica_reg_pages[i].va == 0) {
+			angelica_reg_pages[i].va = ml_io_map(angelica_reg_pages[i].pa, 0x1000);
+		}
+	}
+}
+
+static uint32_t
+angelica_reg_read(uint32_t pa)
+{
+	for (unsigned int i = 0; i < sizeof(angelica_reg_pages) / sizeof(angelica_reg_pages[0]); i++) {
+		if ((pa & ~0xfffU) == angelica_reg_pages[i].pa && angelica_reg_pages[i].va != 0) {
+			return *(volatile uint32_t *)(angelica_reg_pages[i].va + (pa & 0xfffU));
+		}
+	}
+	return 0xffffffffU;
+}
+
+static void
+angelica_log_smp_regs(unsigned int id, const char *when)
+{
+	IOLog("ANGELICA REG %s cpu=%u pwr=%08x/%08x cpupwr=%08x/%08x cfg=%08x\n",
+	    when, id, angelica_reg_read(0x10006180), angelica_reg_read(0x10006184),
+	    angelica_reg_read(0x10006188), angelica_reg_read(0x1000618c),
+	    angelica_reg_read(0x10006000));
+	IOLog("ANGELICA REG %s cpu=%u mp0top=%08x mp0c0=%08x mp1top=%08x mp1c0=%08x bypass=%08x dormant=%08x\n",
+	    when, id, angelica_reg_read(0x10006204), angelica_reg_read(0x10006208),
+	    angelica_reg_read(0x10006218), angelica_reg_read(0x1000621c),
+	    angelica_reg_read(0x100062b4), angelica_reg_read(0x100062b8));
+	IOLog("ANGELICA REG %s cpu=%u boot0=%08x boot4=%08x spark0=%08x spark1=%08x seq0=%08x seq1=%08x emi=%08x\n",
+	    when, id, angelica_reg_read(0x10200038), angelica_reg_read(0x10200238),
+	    angelica_reg_read(0x10201c30), angelica_reg_read(0x10203c30),
+	    angelica_reg_read(0x10201638), angelica_reg_read(0x10203638),
+	    angelica_reg_read(0x10226000));
+}
