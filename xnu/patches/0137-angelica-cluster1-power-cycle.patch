 /*
- * Stock ATF's cluster power-on path releases MP1 bus protection through
- * INFRA_TOPAXI_PROTECTEN_1_CLR. CPU4 can be powered and have a valid boot
- * address while still stalling on instruction fetch behind that protection.
- * Replay the MP1 part before asking PSCI to start CPU4.
+ * CPU4 can be powered with a valid ATF boot address while remaining on
+ * ON_PENDING forever. The cluster is already reported on, so ATF skips its
+ * cluster power-on path, which is what releases MP1 bus protection. Power
+ * CPU4 and cluster1 down first; the following PSCI CPU_ON then takes the
+ * cluster-off path and replays the full stock sequence (top power, bus
+ * protect release, boot address, CPU power).
  */
 static void
-angelica_cluster1_bus_release(void)
+angelica_cluster1_power_cycle(void)
 {
-	angelica_prot_before = angelica_reg_read(0x10001258);
+	angelica_pwr_before = angelica_reg_read(0x10006180);
 	angelica_top_before = angelica_reg_read(0x10006218);
-	uint32_t top = angelica_top_before;
-	top &= ~0x8U;   /* PWR_ON_2ND */
-	top |= 0x1U;    /* PWR_RST_B */
-	top &= ~0x10U;  /* PWR_CLK_DIS */
-	top |= 0x4U;    /* PWR_ON */
-	angelica_reg_write(0x10006218, top);
+	angelica_prot_before = angelica_reg_read(0x10001258);
+
+	uint32_t cpu = angelica_reg_read(0x1000621c);
+	angelica_reg_write(0x1000621c, cpu & ~(0x4U | 0x8U));
+	__builtin_arm_dsb(DSB_SY);
+	for (unsigned int i = 0; i < 1000; i++) {
+		if ((angelica_reg_read(0x10006180) & 0x10000U) == 0) {
+			break;
+		}
+		IOSleep(1);
+	}
+
+	uint32_t top = angelica_reg_read(0x10006218);
+	angelica_reg_write(0x10006218, top & ~(0x4U | 0x8U));
 	__builtin_arm_dsb(DSB_SY);
+	for (unsigned int i = 0; i < 1000; i++) {
+		if ((angelica_reg_read(0x10006180) & 0x8000U) == 0) {
+			break;
+		}
+		IOSleep(1);
+	}
+
 	angelica_reg_write(0x100012ac, 0x0800c800U);
 	__builtin_arm_dsb(DSB_SY);
-	angelica_prot_after = angelica_reg_read(0x10001258);
+	angelica_pwr_after = angelica_reg_read(0x10006180);
 	angelica_top_after = angelica_reg_read(0x10006218);
+	angelica_prot_after = angelica_reg_read(0x10001258);
 }
 
