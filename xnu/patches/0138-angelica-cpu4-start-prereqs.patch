+/*
+ * A redistributor that is still asleep makes ATF's gic_pcpu_init spin before
+ * it ever returns to the non-secure entry point. Wake CPU4's redistributor
+ * from CPU0 and keep the WAKER values for the timeout panic.
+ */
+static void
+angelica_wake_gicr(uint32_t phys_id)
+{
+	if (angelica_gicr_base == 0) {
+		angelica_gicr_base = ml_io_map(0x0c100000, 0x200000);
+	}
+	if (angelica_gicr_base == 0) {
+		angelica_gicr_waker_before = 0xffffffffU;
+		angelica_gicr_waker_after = 0xffffffffU;
+		return;
+	}
+
+	vm_offset_t pe = 0;
+	for (vm_offset_t off = 0; off < 0x200000; off += 0x20000) {
+		vm_offset_t candidate = angelica_gicr_base + off;
+		uint64_t typer = *(volatile uint64_t *)(candidate + 0x08);
+		uint32_t aff = (uint32_t)(typer >> 32) & 0xffffU;
+		if (aff == (phys_id & 0xffffU)) {
+			pe = candidate;
+			break;
+		}
+		if (typer & 0x10U) {
+			break;
+		}
+	}
+	if (pe == 0) {
+		angelica_gicr_waker_before = 0xffffffffU;
+		angelica_gicr_waker_after = 0xffffffffU;
+		return;
+	}
+
+	angelica_gicr_waker_before = *(volatile uint32_t *)(pe + 0x14);
+	if (angelica_gicr_waker_before & 0x4U) {
+		*(volatile uint32_t *)(pe + 0x14) =
+		    angelica_gicr_waker_before & ~0x2U;
+		__builtin_arm_dsb(DSB_SY);
+		for (unsigned int i = 0; i < 1000; i++) {
+			if ((*(volatile uint32_t *)(pe + 0x14) & 0x4U) == 0) {
+				break;
+			}
+			IOSleep(1);
+		}
+	}
+	angelica_gicr_waker_after = *(volatile uint32_t *)(pe + 0x14);
+}
+
+/*
+ * MP1_RGU_DCM is on by default in Android. XNU never enables DCM, and the
+ * CPU4 PWR_CON still has ISO/CLK_DIS/SRAM_PDN set. Enable the RGU DCM and
+ * clear those power-down bits, then read back so the panic shows whether
+ * non-secure writes to MP1_CPU0_PWR_CON actually stick.
+ */
+static void
+angelica_prepare_cluster1_cpu(void)
+{
+	angelica_rgu_dcm_before = angelica_reg_read(0x10200288);
+	angelica_reg_write(0x10200288, angelica_rgu_dcm_before | 0x1U);
+	__builtin_arm_dsb(DSB_SY);
+	angelica_rgu_dcm_after = angelica_reg_read(0x10200288);
+
+	angelica_rgu_mode = angelica_reg_read(0x10007000);
+	angelica_rgu_status = angelica_reg_read(0x1000700c);
+	angelica_rgu_swsysrst = angelica_reg_read(0x10007018);
+
+	angelica_mp1c0_before = angelica_reg_read(0x1000621c);
+	uint32_t cpu = angelica_mp1c0_before & ~0x1b2U;
+	cpu |= 0x1040U;
+	angelica_reg_write(0x1000621c, cpu);
+	__builtin_arm_dsb(DSB_SY);
+	angelica_mp1c0_after = angelica_reg_read(0x1000621c);
+}
