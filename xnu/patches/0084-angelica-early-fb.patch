diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 06bb568..87914ea 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1832,6 +1832,13 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
  * for a Normal-NC framebuffer alias that survives bootstrap TTBR0 teardown.
  */
 #define ANGELICA_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
+#ifdef ARM64_BOARD_CONFIG_ANGELICA
+#define ANGELICA_EARLY_FB_BLOCK_PHYS 0x5e000000ULL
+#define ANGELICA_EARLY_FB_BLOCK_OFFSET 0x605000ULL
+#else
+#define ANGELICA_EARLY_FB_BLOCK_PHYS 0x9c000000ULL
+#define ANGELICA_EARLY_FB_BLOCK_OFFSET 0ULL
+#endif
 
 static void
 angelica_early_map_final(void)
@@ -1843,7 +1850,7 @@ angelica_early_map_final(void)
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
 	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	*slot = ANGELICA_EARLY_FB_BLOCK_PHYS | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
 	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
 	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
 	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
@@ -2190,7 +2197,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 #if defined(ANGELICA)
 	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
-	angelica_early_relocate(ANGELICA_EARLY_FB_VA);
+	angelica_early_relocate(ANGELICA_EARLY_FB_VA + ANGELICA_EARLY_FB_BLOCK_OFFSET);
 #endif
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 023086f..45a7572 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -514,11 +514,19 @@ LEXT(start_first_cpu)
 	mov		x21, #0
 
 #if defined(ANGELICA)
+#if defined(ARM64_BOARD_CONFIG_ANGELICA)
+	/* Stage 0: green 64x32 band at the bottom-left of the live fb. */
+	MOV64	x0, (0x5e605000 + (1600 - 32) * 2880)
+	mov		w1, #0xff00ff00
+	mov		x2, #32
+	mov		x4, #2880
+#else
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
 	MOV64	x0, (0x9c000000 + 2368 * 4320)
 	mov		w1, #-1
 	mov		x2, #32
 	mov		x4, #4320
+#endif
 Langelica_mark_row:
 	mov		x3, #64
 	mov		x5, x0
@@ -686,7 +694,11 @@ Lkernelcache_base_found:
 	 * ANGELICA uses 16K pages and all bring-up RAM is below 4GB, so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
+#ifdef ARM64_BOARD_CONFIG_ANGELICA
+	MOV64	x10, 0x5e000000
+#else
 	MOV64	x10, 0x9c000000
+#endif
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
@@ -698,6 +710,24 @@ Lkernelcache_base_found:
 	/* Ensure TTEs are visible */
 	dsb		ish
 
+#if defined(ARM64_BOARD_CONFIG_ANGELICA)
+	/* Stage 0b: blue 64x32 band next to stage 0 (page tables ready). */
+	MOV64	x0, (0x5e605000 + (1600 - 32) * 2880 + 64 * 4)
+	mov		w1, #0xff0000ff
+	mov		x2, #32
+	mov		x4, #2880
+Langelica_mark2_row:
+	mov		x3, #64
+	mov		x5, x0
+Langelica_mark2_pixel:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Langelica_mark2_pixel
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Langelica_mark2_row
+	dsb		sy
+#endif
 
 	b		common_start
 
diff --git a/osfmk/arm64/angelica_early.c b/osfmk/arm64/angelica_early.c
index 6928957..af2ee31 100644
--- a/osfmk/arm64/angelica_early.c
+++ b/osfmk/arm64/angelica_early.c
@@ -1,5 +1,5 @@
 /*
- * Redmi 9C bootstrap console. No allocation, locks, ADT parsing or
+ * Redmi 9C (ANGELICA) bootstrap console. No allocation, locks, ADT parsing or
  * per-CPU state: panic() can reach this before a current thread exists.
  * start.s maps the splash framebuffer VA=PA as Normal Non-Cacheable memory.
  * arm_vm_init installs a reserved kernel VA alias before removing TTBR0;
@@ -11,12 +11,26 @@
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
-#define EARLY_FB early_fb
+#ifdef ARM64_BOARD_CONFIG_ANGELICA
+#define EARLY_FB_PHYS 0x5e605000u
+#define EARLY_WIDTH 720u
+#define EARLY_HEIGHT 1600u
+#define EARLY_STRIDE (2880u / 4)
+#define EARLY_SCALE 1u
+#define EARLY_MARK_W 32u
+#define EARLY_TOP_ROWS 3u
+#else
+#define EARLY_FB_PHYS 0x9c000000u
 #define EARLY_WIDTH 1080u
 #define EARLY_HEIGHT 2400u
 #define EARLY_STRIDE (4320u / 4)
 #define EARLY_SCALE 2u
+#define EARLY_MARK_W 48u
+#define EARLY_TOP_ROWS 0u
+#endif
+
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)EARLY_FB_PHYS;
+#define EARLY_FB early_fb
 #define EARLY_CELL_W (8u * EARLY_SCALE)
 #define EARLY_CELL_H (16u * EARLY_SCALE)
 #define EARLY_ROWS ((EARLY_HEIGHT - 32u) / EARLY_CELL_H)
@@ -47,6 +61,13 @@ angelica_early_putc(char c)
 	}
 	if (!early_started) {
 		early_started = 1;
+#if defined(ARM64_BOARD_CONFIG_ANGELICA)
+		for (unsigned int r = 0; r < EARLY_ROWS; r++) {
+			early_row = r;
+			angelica_early_clear_row();
+		}
+#endif
+		early_row = EARLY_TOP_ROWS;
 		angelica_early_clear_row();
 	}
 	if (c == '\r') {
@@ -94,7 +115,7 @@ angelica_early_mark(unsigned int stage, const char *label)
 	}
 	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
 	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
-		for (unsigned int x = stage * 48; x < (stage + 1) * 48; x++) {
+		for (unsigned int x = stage * EARLY_MARK_W; x < (stage + 1) * EARLY_MARK_W; x++) {
 			EARLY_FB[y * EARLY_STRIDE + x] = color;
 		}
 	}
