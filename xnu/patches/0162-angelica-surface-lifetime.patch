+	AngelicaSurfaceRef *ref = findRef((uint32_t)(uintptr_t)id, NULL);
+	if (ref != NULL) {
+		ref->count--;
 	}
 	IOLockUnlock(fLock);
 	return ref != NULL ? kIOReturnSuccess : kIOReturnNotFound;
