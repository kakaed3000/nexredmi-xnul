 {
-	unsigned int index;
+	/*
+	 * Decrement the use count, but never remove the object or unmap its
+	 * data/state pages: iOS keeps using the surface after DecrementUseCount
+	 * and expects it to stay valid until clientClose. Removing it here was
+	 * why every app crashed on its next access to the surface.
+	 */
 	IOLockLock(fLock);
-	AngelicaSurfaceRef *ref = findRef((uint32_t)(uintptr_t)id, &index);
