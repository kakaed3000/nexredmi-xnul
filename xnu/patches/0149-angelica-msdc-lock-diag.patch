+static void
+msdc_lock_busy(void)
+{
+	int tid = msdc_owner_tid;
+	int pid = msdc_owner_pid;
+
+	if (tid == 0 ||
+	    (tid == msdc_reported_tid && sm.last_stage == msdc_reported_stage)) {
+		return;
+	}
+	msdc_reported_tid = tid;
+	msdc_reported_stage = sm.last_stage;
+	kprintf("ANGELICA MSDC: lock busy holder t%d pid %d stage %s "
+	    "cfg=0x%x sdc_cfg=0x%x sts=0x%x fifo=0x%x int=0x%x dma=0x%x\n",
+	    tid, pid, sm.last_stage ? sm.last_stage : "none",
+	    msdc_rd(MSDC_CFG), msdc_rd(SDC_CFG), msdc_rd(SDC_STS),
+	    msdc_rd(MSDC_FIFOCS), msdc_rd(MSDC_INT), msdc_rd(MSDC_DMA_CFG));
+}
+
+static void
+msdc_lock_acquire(void)
+{
+	proc_t p = current_proc();
+
+	if (!lck_mtx_try_lock(&angelica_msdc_lock)) {
+		msdc_lock_busy();
+		lck_mtx_lock(&angelica_msdc_lock);
+	}
+	msdc_owner_tid = (int)thread_tid(current_thread());
+	msdc_owner_pid = p != NULL ? proc_pid(p) : 0;
+}
+
+static void
+msdc_lock_release(void)
+{
+	msdc_owner_tid = 0;
+	msdc_owner_pid = 0;
+	lck_mtx_unlock(&angelica_msdc_lock);
+}
