 /*
+ * Switch the card into 8-bit DDR52 (high speed timing, DDR bus width) and
+ * the host into the same DDR configuration the bootloader uses: MSDC_CFG
+ * CKMOD=2 (DDR mode with divisor), 8-bit SDC_CFG, CLK-pin busy delay,
+ * DDR50SEL and CRC-status latch from the reference register dump.  Card
+ * side requires HS_TIMING=1 (CMD6 index 185) and BUS_WIDTH=6 (CMD6 index
+ * 183, 8-bit DDR); both are legal at the current I/O voltage.
+ */
+static int
+msdc_set_ddr52(uint64_t hz)
+{
+	uint32_t arg, cfg, pb0, pb2, resp;
+	int error;
+
+	/* 1. card: high speed (52 MHz) timing */
+	arg = (MSDC_SWITCH_WRITE << 24) | (EXT_CSD_HS_TIMING << 16) |
+	    (MSDC_DDR_HS_TIMING << 8);
+	error = msdc_cmd(6, arg, R1B_RSPTYP, 0, &resp);
+	if (error) {
+		return error;
+	}
+	if (resp & (R1_OUT_OF_RANGE | R1_ERROR)) {
+		kprintf("ANGELICA MSDC: CMD6 HS_TIMING status 0x%x\n", resp);
+		return EIO;
+	}
+	error = msdc_wait_ready();
+	if (error) {
+		return error;
+	}
+
+	/* 2. card: 8-bit DDR bus width */
+	arg = (MSDC_SWITCH_WRITE << 24) | (EXT_CSD_BUS_WIDTH << 16) |
+	    (MSDC_DDR_BUS_WIDTH << 8);
+	error = msdc_cmd(6, arg, R1B_RSPTYP, 0, &resp);
+	if (error) {
+		return error;
+	}
+	if (resp & (R1_OUT_OF_RANGE | R1_ERROR)) {
+		kprintf("ANGELICA MSDC: CMD6 BUS_WIDTH status 0x%x\n", resp);
+		return EIO;
+	}
+	error = msdc_wait_ready();
+	if (error) {
+		return error;
+	}
+
+	/* 3. host: 8-bit */
+	cfg = msdc_rd(SDC_CFG);
+	cfg = (cfg & ~SDC_CFG_BUSWIDTH) | (2u << 16);
+	msdc_wr(SDC_CFG, cfg);
+	sm.width = 8;
+
+	/* 4. host: patch bits from the reference (LK) register dump */
+	pb0 = msdc_rd(MSDC_PATCH_BIT0);
+	pb0 |= MSDC_PB0_EN_STBIT_CHKSUP | MSDC_PB0_EN_8BITSUP |
+	    MSDC_PB0_DIS_RECMDWR | MSDC_PB0_SDC_BSYDLY | MSDC_PB0_DETWR_CRCTMO;
+	pb0 &= ~MSDC_PB0_RD_DAT_SEL;
+	msdc_wr(MSDC_PATCH_BIT0, pb0);
+	pb2 = msdc_rd(MSDC_PATCH_BIT2);
+	pb2 |= MSDC_PB2_ENHANCEGPD | MSDC_PB2_RESPWAITCNT |
+	    MSDC_PB2_INTCRESPSEL | MSDC_PB2_CFGRESPCNT |
+	    MSDC_PB2_DDR50SEL | MSDC_PB2_POPENCNT |
+	    MSDC_PB2_CFG_CRCSTS_SEL | MSDC_PB2_CFGCRCSTSEDGE;
+	msdc_wr(MSDC_PATCH_BIT2, pb2);
+
+	/* 5. host: command/response transmission delay compensation */
+	msdc_wr(MSDC_EMMC50_CFG0, MSDC_EMMC50_CFG_LK);
+
+	/* 6. clock: mode 0 divisor for the target rate, then CKMOD=2 (DDR) */
+	error = msdc_set_mclk(hz);
+	if (error) {
+		return error;
+	}
+	cfg = msdc_rd(MSDC_CFG);
+	cfg &= ~(MSDC_CFG_CKMOD | MSDC_CFG_CKMOD_HS400 | MSDC_CFG_SCLK_STOP_DDR);
+	cfg |= (0x2u << 20);          /* CKMOD: DDR with divisor */
+	msdc_wr(MSDC_CFG, cfg);
+	for (uint32_t i = 0; !(msdc_rd(MSDC_CFG) & MSDC_CFG_CKSTB) && i < 1000; i++) {
+		delay(1);
+	}
+	if (!(msdc_rd(MSDC_CFG) & MSDC_CFG_CKSTB)) {
+		sm.last_stage = "ddr-ckstb";
+		return ETIMEDOUT;
+	}
+	sm.sclk_hz = hz;
+	sm.last_stage = "ddr52-ok";
+	kprintf("ANGELICA MSDC: DDR52 ok sclk %llu width 8 cfg=0x%x sdc_cfg=0x%x "
+	    "pb0=0x%x pb2=0x%x emmc50_cfg0=0x%x\n",
+	    (unsigned long long)sm.sclk_hz, msdc_rd(MSDC_CFG), msdc_rd(SDC_CFG),
+	    msdc_rd(MSDC_PATCH_BIT0), msdc_rd(MSDC_PATCH_BIT2),
+	    msdc_rd(MSDC_EMMC50_CFG0));
+	return 0;
+}
