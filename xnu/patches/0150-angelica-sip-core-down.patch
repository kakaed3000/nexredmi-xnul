+/* Vendor SIP 0xC2000212: power down one CPU through ATF's SPMC path. */
+static int32_t
+angelica_sip_power_down_core(uint64_t core)
+{
+	register uint64_t x0 __asm__("x0") = 0xC2000212ULL;
+	register uint64_t x1 __asm__("x1") = core;
+	register uint64_t x2 __asm__("x2") = 0;
+	register uint64_t x3 __asm__("x3") = 0;
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int32_t)x0;
+}
+
