+static void
+angelica_log_cpu_states(const char *when)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+
+	for (unsigned int i = 0; i < topology->num_cpus; i++) {
+		AngelicaCPU *cpu = __atomic_load_n(&angelica_cpus[i], __ATOMIC_ACQUIRE);
+		IOLog("ANGELICA CPUSTATE %s cpu=%u mpidr=0x%x init=%u sgi=%u affinity=%d\n",
+		    when, i, topology->cpus[i].phys_id,
+		    cpu ? cpu->getInitialized() : 0,
+		    angelica_cpu_signal_is_enabled(i),
+		    angelica_psci_affinity_info(topology->cpus[i].phys_id, 0));
+	}
+}
