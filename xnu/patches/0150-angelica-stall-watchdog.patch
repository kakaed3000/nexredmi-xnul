+/*
+ * Print a stuck sector read even when no second thread is waiting on the
+ * lock.  This is what identifies a holder that spins in delay() forever.
+ */
+static void
+msdc_watchdog_thread(void *arg, wait_result_t wr)
+{
+	uint64_t threshold, now, start;
+	int tid;
+
+	(void)arg;
+	(void)wr;
+	nanoseconds_to_absolutetime(5ull * NSEC_PER_SEC, &threshold);
+
+	for (;;) {
+		tsleep(&msdc_watchdog_chan, PZERO, "msdcwd", 10 * hz);
+		tid = msdc_io_tid;
+		if (tid == 0) {
+			continue;
+		}
+		now = mach_absolute_time();
+		start = msdc_io_start;
+		if (now <= start + threshold) {
+			continue;
+		}
+		if (tid == msdc_watchdog_reported_tid && sm.last_stage == msdc_watchdog_stage) {
+			continue;
+		}
+		msdc_watchdog_reported_tid = tid;
+		msdc_watchdog_stage = sm.last_stage;
+		kprintf("ANGELICA MSDC: read stalled t%d pid %d lba 0x%llx "
+		    "stage %s start 0x%llx now 0x%llx owner t%d pid %d "
+		    "cfg=0x%x sdc_cfg=0x%x sts=0x%x fifo=0x%x int=0x%x dma=0x%x\n",
+		    tid, msdc_io_pid, (unsigned long long)msdc_io_lba,
+		    sm.last_stage ? sm.last_stage : "none",
+		    (unsigned long long)start, (unsigned long long)now,
+		    msdc_owner_tid, msdc_owner_pid,
+		    msdc_rd(MSDC_CFG), msdc_rd(SDC_CFG), msdc_rd(SDC_STS),
+		    msdc_rd(MSDC_FIFOCS), msdc_rd(MSDC_INT), msdc_rd(MSDC_DMA_CFG));
+	}
+}
