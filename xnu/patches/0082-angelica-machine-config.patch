 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := $(shell echo $(CURRENT_ARCH_CONFIG) | tr A-Z a-z)
 ifneq ($(filter arm64,$(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG)),)
-# angelica: Cortex-A53 has no pointer authentication: stay plain arm64
-ifneq ($(CURRENT_MACHINE_CONFIG),ANGELICA)
+# angelica: Cortex-A53 has no pointer
+# authentication: stay plain arm64
+ifeq ($(filter ANGELICA ANGELICA,$(CURRENT_MACHINE_CONFIG)),)
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := arm64e
 endif
 endif
diff --git a/pexpert/pexpert/arm64/ANGELICA.h b/pexpert/pexpert/arm64/ANGELICA.h
new file mode 100644
index 0000000..4fe07d0
--- /dev/null
+++ b/pexpert/pexpert/arm64/ANGELICA.h
@@ -0,0 +1,79 @@
+/*
+ * Board config for the Redmi 9C ("angelica", MediaTek MT6765 / Helio G35):
+ * 8x Cortex-A53 (ARMv8.0: no PAN, no LSE), 16K pages, GICv3, no PAC.
+ *
+ * The ANGELICA machine config passes BOTH -DARM64_BOARD_CONFIG_ANGELICA and
+ * -DARM64_BOARD_CONFIG_ANGELICA, and this header defines ANGELICA as well, so the
+ * entire angelica patch series (drivers, identity, crypto, master-config files)
+ * compiles for angelica unchanged; angelica-only deltas are gated on
+ * defined(ANGELICA) or on this file's own values.
+ *
+ * Timer PPI numbering follows the ARM architecture (13/14/11/10: secure
+ * phys, phys, virt, hyp), so the virtual timer XNU uses (CNTV) is
+ * INTID 16 + 11 = 27 - MediaTek renumbers those on angelica (-> 19), MTK does
+ * not. GIC/timer addresses are not hardcoded anywhere: pe_fiq reads the
+ * gic node's reg + virtual-timer-intid from the ADT built by mkadt.
+ */
+
+#ifndef _PEXPERT_ARM64_ANGELICA_H
+#define _PEXPERT_ARM64_ANGELICA_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define ANGELICA                     1
+#define ANGELICA                  1
+#define ANGELICA_SMP_MAX_CPUS        8
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+/* Cortex-A53 is ARMv8.0: no FEAT_PAN, leave __ARM_PAN_AVAILABLE__ undefined
+ * (same as the upstream BCM2837 board config, also Cortex-A53). */
+#define __ARM_16K_PG__            1
+
+#define HAS_GIC_V3                1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+#define ANGELICA_VTIMER_INTID        27
+#define ANGELICA_IPI_SGI             1       // SGI used for cross-CPU signals
+
+#define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
+
+#define GICR_PE_SIZE              0x20000 // Size of each redistributor region
+
+/* GICv3 register definitions; see GICv3 spec (Arm IHI 0069G) */
+#define GICD_CTLR                 0x0
+
+/* Non-secure view of GICD_CTLR (DS=0) */
+#define GICD_CTLR_ENABLEGRP1      0x1
+#define GICD_CTLR_ENABLEGRP1A     0x2
+#define GICD_CTLR_ARE_NS          0x10
+#define GICD_CTLR_RWP             0x80000000
+
+#define GICR_TYPER                              0x08
+#define GICR_WAKER                              0x14
+#define GICR_IGROUPR0                           0x10080
+#define GICR_ISENABLER0                         0x10100
+#define GICR_IPRIORITYR0                        0x10400
+
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT         32
+#define GICR_TYPER_LAST                         0x10
+
+#define GICR_WAKER_PROCESSORSLEEP               0x2
+#define GICR_WAKER_CHILDRENASLEEP               0x4
+
+#define ICC_CTLR_EOIMODE                        0x2
+
+#define ICC_SRE_SRE                             0x1
+/* End of GICv3 register definitions */
+
+#endif /* ! _PEXPERT_ARM64_ANGELICA_H */
