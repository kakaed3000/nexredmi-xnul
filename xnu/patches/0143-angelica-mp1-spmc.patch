+	angelica_cpusys1_ctl_before = angelica_reg_read(0x10203c30);
+
+	uint32_t ctl = angelica_cpusys0_cpu1_spmc & 0x0007ffffU;
+	ctl &= ~((1U << 6) | (1U << 9) | (1U << 10) | (0x1fU << 11) |
+	    (1U << 16));
+	ctl |= (1U << 0) | (1U << 1) | (1U << 7) | (1U << 8);
+	angelica_reg_write(0x10203c30, ctl);
+	__builtin_arm_dsb(DSB_SY);
+	angelica_cpusys1_ctl_after = angelica_reg_read(0x10203c30);
+	angelica_cpusys1_sparken_after = angelica_reg_read(0x10203c04);
+	angelica_cpusys1_vret_after = angelica_reg_read(0x10203c00);
+	angelica_cpusys1_amux_after = angelica_reg_read(0x10203c08);
+
