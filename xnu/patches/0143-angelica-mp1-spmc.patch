 	angelica_mp1c0_after = angelica_reg_read(0x1000621c);
 
 	/*
+	 * ATF's SPMC tables leave MP1_CPUTOP_SPMC_CTL in the cluster-off
+	 * state (ISO/CLK_DIS/CKISO/HOT_PLUG_RESET), unlike MP0. Use MP0's
+	 * control bits as the on template and leave the ACK bits alone.
+	 */
+	angelica_mp0_spmc = angelica_reg_read(0x10200788);
+	angelica_mp1_spmc_before = angelica_reg_read(0x1020078c);
+	uint32_t spmc = angelica_mp1_spmc_before;
+	spmc &= ~((1U << 6) | (1U << 14) | (1U << 15) | (1U << 22));
+	spmc |= (angelica_mp0_spmc & ((1U << 0) | (1U << 1) | (1U << 3) |
+	    (1U << 4) | (1U << 5) | (1U << 13)));
+	angelica_reg_write(0x1020078c, spmc);
+	__builtin_arm_dsb(DSB_SY);
+	angelica_mp1_spmc_after = angelica_reg_read(0x1020078c);
+
+	/*
+	 * CPUSYS1 SPMC is also left at zero. CPU1 on cluster0 is a known-good
+	 * secondary-core template; clear isolation/clock/power-down and enable
+	 * SPARK before CPU_ON so CPU4 has a running clock.
+	 */
+	angelica_cpusys1_vret_before = angelica_reg_read(0x10203c00);
+	angelica_cpusys1_sparken_before = angelica_reg_read(0x10203c04);
+	angelica_cpusys1_amux_before = angelica_reg_read(0x10203c08);
