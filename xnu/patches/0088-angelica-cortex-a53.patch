diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index e4e6535..f0c418f 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -62,10 +62,13 @@ MACHINE_FLAGS_ARM64_T6000 = -DARM64_BOARD_CONFIG_T6000 		-mcpu=apple-a14
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a
 MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
 MACHINE_FLAGS_ARM64_ANGELICA = -DARM64_BOARD_CONFIG_ANGELICA                -march=armv8.2-a+crypto
-# angelica: Cortex-A53 (ARMv8.0, no LSE/PAN => plain armv8-a, not armv8.2).
+# angelica: Cortex-A53 (ARMv8.0, no LSE/PAN).  Use -mcpu, not -march: on the
+# Darwin target Apple clang keeps its default -mcpu (apple-m1) and only ORs the
+# -march features in, so LSE atomics (ldadd) leak into the kernel and trap on
+# the A53.  -mcpu=cortex-a53 replaces the target CPU (LL/SC atomics, +crypto).
 # The ANGELICA define joins so the whole angelica patch series compiles unchanged;
 # ANGELICA.h (via ARM64_BOARD_CONFIG_ANGELICA) overrides what differs.
-MACHINE_FLAGS_ARM64_ANGELICA = -DARM64_BOARD_CONFIG_ANGELICA -DARM64_BOARD_CONFIG_ANGELICA -march=armv8-a+crypto
+MACHINE_FLAGS_ARM64_ANGELICA = -DARM64_BOARD_CONFIG_ANGELICA -DARM64_BOARD_CONFIG_ANGELICA -mcpu=cortex-a53+crypto
 
 
 #
