-/*
- * Policy "Sandbox": libsystem_sandbox calls __mac_syscall("Sandbox", op,
- * arg). Without a policy of that name every call fails with ENOPOLICY and
- * launchd reports mach lookups as "error = 159: Sandbox restriction"
- * (backboardd cannot reach mobilegestalt or iohideventsystem; tccd:
- * "profile not found"). ANGELICA runs without a sandbox: operations succeed
- * (checks allow, profile init is accepted); the few that must return
- * data (container paths, extension tokens) fail with ENOENT. The first
- * use of each operation number is logged.
- */
-static uint64_t angelica_sandbox_seen;
-
-static int
-angelica_sandbox_syscall(struct proc *p, int call, __unused user_addr_t arg)
-{
-	if (call >= 0 && call < 64 && !(angelica_sandbox_seen & (1ULL << call))) {
-		angelica_sandbox_seen |= 1ULL << call;
-		char name[32];
-		proc_name(proc_pid(p), name, sizeof(name));
-		printf("ANGELICA Sandbox: %s op %d\n", name, call);
-	}
-	switch (call) {
-	case 4:         /* container path (audit token / pid) */
-	case 5:         /* extension issue */
-	case 6:         /* extension consume */
-	case 0x43:      /* container expected */
-		return ENOENT;
-	default:
-		return 0;
-	}
-}
-
-static const struct mac_policy_ops angelica_amfi_mac_ops = {
-	.mpo_vnode_check_signature = angelica_amfi_vnode_check_signature,
-};
-
-/*
- * Privileges for non-root processes come from MAC policies (priv_check_cred
- * -> mac_priv_grant); on iOS Sandbox/AMFI grant them. Without a grant UIKit
- * apps die in CoreAnimation setup: work_interval_create(CA_CLIENT) needs
- * PRIV_WORK_INTERVAL ("Failed to create work interval", SpringBoard).
- * Grant that one; log the first denial of each other privilege per process.
- */
-#define ANGELICA_PRIV_LOG_MAX      64
-static struct {
-	int  priv;
-	char name[20];
-} angelica_priv_logged[ANGELICA_PRIV_LOG_MAX];
-static int angelica_priv_logged_count;
-
-static int
-angelica_sandbox_priv_grant(kauth_cred_t cred __unused, int priv)
-{
-	if (priv == PRIV_WORK_INTERVAL) {
-		return 0;
-	}
-	char name[20];
-	proc_selfname(name, sizeof(name));
-	for (int i = 0; i < angelica_priv_logged_count; i++) {
-		if (angelica_priv_logged[i].priv == priv &&
-		    strncmp(angelica_priv_logged[i].name, name, sizeof(name)) == 0) {
-			return EPERM;
-		}
-	}
-	if (angelica_priv_logged_count < ANGELICA_PRIV_LOG_MAX) {
-		angelica_priv_logged[angelica_priv_logged_count].priv = priv;
-		strlcpy(angelica_priv_logged[angelica_priv_logged_count].name, name, sizeof(name));
-		angelica_priv_logged_count++;
-		printf("ANGELICA Sandbox: %s privilege %d denied\n", name, priv);
-	}
-	return EPERM;
-}
-
-static const struct mac_policy_ops angelica_sandbox_mac_ops = {
-	.mpo_policy_syscall = angelica_sandbox_syscall,
-	.mpo_priv_grant = angelica_sandbox_priv_grant,
-};
-
-static struct mac_policy_conf angelica_sandbox_mac_conf = {
