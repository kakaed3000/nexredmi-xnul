@@ -0,0 +1,26 @@
+/* Built-in provider: Apple libpthread-514.100.2, paired with xnu-8796.141.3. */
+#if defined(ARM64_BOARD_CONFIG_ANGELICA)
+#include "angelica_pthread_compat.h"
+#include "angelica_libpthread/kern/kern_init.c"
+
+/* Keep the provider's full layout within the kernel's reserved storage. */
+_Static_assert(sizeof(struct ksyn_waitq_element) == 56,
+    "update ANGELICA ksyn storage in sys/pthread_internal.h");
+
+/* Restore the startup interface after compiling the provider's kext code. */
+#define XNU_KERNEL_PRIVATE 1
+#include <kern/startup.h>
+#include <pexpert/pexpert.h>
+
+__startup_func
+static void
+angelica_pthread_register(void)
+{
+    kern_return_t kr = angelica_pthread_start(NULL, NULL);
+    if (kr != KERN_SUCCESS || angelica_pthread_kern == NULL) {
+        panic("ANGELICA: pthread provider registration failed: %d", kr);
+    }
+    kprintf("ANGELICA pthread: libpthread-514.100.2 registered\n");
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_SECOND, angelica_pthread_register);
