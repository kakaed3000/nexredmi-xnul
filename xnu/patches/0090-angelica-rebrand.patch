-
-/* Called from bsd_init once MAC policies can register, before any exec. */
-void angelica_amfi_policy_register(void);
-
-void
-angelica_amfi_policy_register(void)
-{
-	int error = mac_policy_register(&angelica_amfi_mac_conf, &angelica_amfi_mac_handle, NULL);
-	printf("ANGELICA AMFI: platform binary policy %s (%d)\n",
