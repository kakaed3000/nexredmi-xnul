+#if defined(ARM64_BOARD_CONFIG_ANGELICA)
+static void
+angelica_log_exec(proc_t p, struct image_params *imgp, int spawn, int exec)
+{
+	struct _posix_spawnattr *psa = (struct _posix_spawnattr *)imgp->ip_px_sa;
+	pid_t ppid = p->p_pptr != NULL ? proc_getpid(p->p_pptr) : 0;
+
+	printf("ANGELICA exec: pid %d ppid %d name %s uid %u spawn %d exec %d psa 0x%x path %.*s argv [",
+	    proc_getpid(p), ppid, p->p_name, proc_getuid(p), spawn, exec,
+	    psa != NULL ? (unsigned int)psa->psa_flags : 0,
+	    (int)imgp->ip_ndp->ni_cnd.cn_namelen, imgp->ip_ndp->ni_cnd.cn_nameptr);
+	if (imgp->ip_startargv != NULL && imgp->ip_endargv > imgp->ip_startargv) {
+		char *arg = imgp->ip_startargv;
+		for (int i = 0; i < imgp->ip_argc && i < 12; i++) {
+			if (arg >= imgp->ip_endargv) {
+				break;
+			}
+			size_t max = (size_t)(imgp->ip_endargv - arg);
+			size_t len = strnlen(arg, max);
+			if (len == max) {
+				break;
+			}
+			printf("%s%.*s", i != 0 ? " " : "", (int)len, arg);
+			arg += len + 1;
+		}
+	}
+	printf("]\n");
+}
+#endif
