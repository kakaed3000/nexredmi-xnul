+void
+AngelicaCPU::startLate(void *arg, wait_result_t result __unused)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	uint32_t first = (uint32_t)(uintptr_t)arg;
+	uint64_t deadline;
+
+	IOSleep(20000);
+	IOLog("ANGELICA CPU: late diagnostic wake first=%u\n", first);
+	for (uint32_t i = first; i < topology->num_cpus; i++) {
+		AngelicaCPU *cpu = __atomic_load_n(&angelica_cpus[i], __ATOMIC_ACQUIRE);
+		if (cpu == NULL) {
+			IOLog("ANGELICA CPU: late cpu=%u not registered\n", i);
+			break;
+		}
+		IOLog("ANGELICA CPU: late start cpu=%u mpidr=0x%x\n",
+		    i, topology->cpus[i].phys_id);
+		angelica_late_mode = 1;
+		kern_return_t kr = processor_start(cpu->machProcessor);
+		if (kr != KERN_SUCCESS) {
+			angelica_late_mode = 0;
+			IOLog("ANGELICA CPU: late cpu=%u processor_start rc=%d\n", i, kr);
+			break;
+		}
+		boolean_t timed_out = FALSE;
+		nanoseconds_to_deadline(20 * NSEC_PER_SEC, &deadline);
+		while (__atomic_load_n(&cpu->initialized, __ATOMIC_ACQUIRE) == 0 ||
+		    !angelica_cpu_signal_is_enabled(i)) {
+			if (mach_absolute_time() > deadline) {
+				timed_out = TRUE;
+				break;
+			}
+			IOSleep(1);
+		}
+		angelica_late_mode = 0;
+		if (timed_out) {
+			flush_dcache((vm_offset_t)&angelica_trace[i], 8, 0);
+			IOLog("ANGELICA CPU: late cpu=%u NOT alive init=%u sgi=%u trace=0x%llx\n",
+			    i, __atomic_load_n(&cpu->initialized, __ATOMIC_ACQUIRE),
+			    angelica_cpu_signal_is_enabled(i), angelica_trace[i]);
+			angelica_log_smp_regs(i, "late-timeout");
+			IOLog("ANGELICA REG late-timeout cpu=%u prot=%08x sipdown=%d affinity=%d c1ctl=%08x mp1spmc=%08x arch0=%08x arch1=%08x\n",
+			    i, angelica_reg_read(0x10001258),
+			    angelica_sip_power_down_rc,
+			    angelica_psci_affinity_info(topology->cpus[i].phys_id, 0),
+			    angelica_reg_read(0x10203c30),
+			    angelica_reg_read(0x1020078c),
+			    angelica_reg_read(0x1020003c),
+			    angelica_reg_read(0x1020023c));
+			break;
+		}
+		IOLog("ANGELICA CPU: late cpu=%u came alive; SGI1 OK\n", i);
+	}
+	IOLog("ANGELICA CPU: late diagnostic done\n");
 	thread_terminate(current_thread());
 }
 
