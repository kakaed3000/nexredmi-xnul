@@ -6324,7 +6324,17 @@
 	}
 
 	if (wiredcnt_updated && (OSAddAtomic16(-1, (volatile int16_t*)wiredcnt) <= 0)) {
+#if defined(ARM64_BOARD_CONFIG_ANGELICA)
+		/*
+		 * ANGELICA: in our 4K-hw/16K-sw page port the wiredcnt accounting
