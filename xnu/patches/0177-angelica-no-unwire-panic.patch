+		(void)wiredcnt;
+#else
 		panic("pmap_enter(): over-unwire of ptdp %p for pte %p", ptep_get_ptd(pte_p), pte_p);
+#endif
 	}
 
 	pmap_unlock(pmap, lock_mode);
