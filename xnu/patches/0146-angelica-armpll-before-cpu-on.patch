+static void
+angelica_armpll_enable(unsigned int id)
+{
+	uint32_t con0 = angelica_reg_read(0x1000c20c);
+	uint32_t con3 = angelica_reg_read(0x1000c218);
+
+	IOLog("ANGELICA PREPLL cpu=%u b=%x b3=%x\n", id, con0, con3);
+	if (con0 & 0x1U) {
+		return;
+	}
+
+	angelica_reg_write(0x1000c218, con3 | 0x1U);
+	IOSleep(1);
+	angelica_reg_write(0x1000c218, angelica_reg_read(0x1000c218) & ~0x2U);
+	IOSleep(1);
+	angelica_reg_write(0x1000c210, angelica_reg_read(0x1000c210) | 0x80000000U);
+	con0 = angelica_reg_read(0x1000c20c);
+	angelica_reg_write(0x1000c20c, (con0 & ~0x800000U) | 0x1U);
+	IOSleep(1);
+	angelica_reg_write(0x1000c20c, angelica_reg_read(0x1000c20c) | 0x800000U);
+	IOSleep(1);
+	__builtin_arm_dsb(DSB_SY);
+	IOLog("ANGELICA PREPLL cpu=%u a=%x a3=%x\n", id,
+	    angelica_reg_read(0x1000c20c), angelica_reg_read(0x1000c218));
+}
