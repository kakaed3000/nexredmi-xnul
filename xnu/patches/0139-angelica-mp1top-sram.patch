+	/*
+	 * CPU0's CPUTOP keeps SRAM_PDN/CKISO/CLAMP clear, but after the
+	 * cluster power cycle MP1_CPUTOP is left at d18011a7 (SRAM_PDN set).
+	 * ATF's cluster-on path only raises PWR_ON; clear the MP1 SRAM
+	 * power-down bits and re-assert SRAM_ISOINT_B before CPU_ON.
+	 */
+	angelica_mp1top_before = angelica_reg_read(0x10006218);
+	uint32_t top = angelica_mp1top_before & ~0x1b2U;
+	top |= 0x1040U;
+	angelica_reg_write(0x10006218, top);
+	__builtin_arm_dsb(DSB_SY);
+	angelica_mp1top_after = angelica_reg_read(0x10006218);
+
 	angelica_mp1c0_before = angelica_reg_read(0x1000621c);
 	uint32_t cpu = angelica_mp1c0_before & ~0x1b2U;
